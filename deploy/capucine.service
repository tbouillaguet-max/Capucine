# Service systemd pour lancer Capucine au démarrage d'un Raspberry Pi.
#
#   sudo cp deploy/capucine.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now capucine
#   journalctl -u capucine -f
#
# Adaptez User, WorkingDirectory et ExecStart à votre installation.

[Unit]
Description=Capucine, assistante vocale locale
# L'audio et le réseau local (pour Ollama) doivent être prêts.
After=sound.target network.target
Wants=sound.target

[Service]
Type=simple
User=pi
Group=audio
WorkingDirectory=/home/pi/Capucine
Environment="PYTHONUNBUFFERED=1"
Environment="CAPUCINE_PROFILE=pi"
# Décommentez pour forcer un périphérique :
# Environment="CAPUCINE_AUDIO__INPUT_DEVICE=USB PnP Sound Device"
ExecStart=/home/pi/Capucine/.venv/bin/python /home/pi/Capucine/main.py --json-logs

# Une carte SD n'aime pas les redémarrages en boucle : on laisse respirer.
Restart=on-failure
RestartSec=10

# Le modèle de langage vit chez Ollama, pas ici : quelques centaines de méga
# suffisent à Capucine elle-même. Relevez la limite si vous utilisez
# llama-cpp-python en processus.
MemoryMax=1500M
Nice=-5

# Durcissement raisonnable : Capucine n'a besoin que de son dossier et de
# ~/.capucine pour les données des plugins.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=/home/pi/Capucine/models /home/pi/.capucine

[Install]
WantedBy=multi-user.target
