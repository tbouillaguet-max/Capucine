# Poids de modèles : jamais dans le dépôt.
models/*
!models/.gitkeep

__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.venv/
venv/
.env

.pytest_cache/
.ruff_cache/
.coverage
htmlcov/

# Données locales des plugins (notes, état des minuteurs…).
.capucine/

# Les routines que Capucine écrit elle-même vivent chez vous, pas dans le
# dépôt : elles décrivent VOS enchaînements. Supprimez la ligne si vous
# voulez les versionner.
plugins/routine_*.py
plugins/*.routine-tmp
